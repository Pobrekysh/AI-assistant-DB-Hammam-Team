# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university
DB_USER=app_user
DB_PASSWORD=secret

# ===== LLM API =====
# Выбери одну из платформ
OPENAI_API_KEY=sk-your-key-here
# или
GIGACHAT_API_KEY=your-key-here
# или
YANDEX_API_KEY=your-key-here

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ===== Приложение =====
BACKEND_URL=http://localhost:8000
QUERY_LIMIT=100
STATEMENT_TIMEOUT=5