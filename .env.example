# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university_db
DB_USER=app_user
DB_PASSWORD=secret

# ===== LLM API =====
GIGACHAT_API_KEY=your-key-here

LLM_PROVIDER=gigachad
LLM_MODEL=Gigachat

# ===== Приложение =====
BACKEND_URL=http://localhost:8000
QUERY_LIMIT=100
STATEMENT_TIMEOUT=5
MOCK_MODE = false
